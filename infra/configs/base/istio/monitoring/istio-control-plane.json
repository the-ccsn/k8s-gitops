          },
          "expr": "sum(rate(go_memstats_alloc_bytes_total{pod=~\"istiod-.*\",k8s_cluster_name=\"$k8s_cluster_name\"}[$__rate_interval])) by(pod)",
          "legendFormat": "Bytes ({{pod}})",
          "refId": "A"

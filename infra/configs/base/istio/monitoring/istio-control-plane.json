      "pluginVersion": "v11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(istio_build{component=\"pilot\",k8s_cluster_name=\"$k8s_cluster_name\"}) by(tag)",
          "legendFormat": "Version ({{tag}})",
          "refId": "A"
        }

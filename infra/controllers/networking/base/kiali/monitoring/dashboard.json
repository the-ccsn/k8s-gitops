{
  "title": "Kiali",
  "uid": "kiali",
  "tags": [
    "kiali",
    "istio"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Kiali Up",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "up{k8s_cluster_name=\"$k8s_cluster_name\",namespace=\"$namespace\",job=\"$job\"}",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "API hit rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(kiali_api_processing_duration_seconds_count{k8s_cluster_name=\"$k8s_cluster_name\",namespace=\"$namespace\",job=\"$job\"}[$__rate_interval])) by(route)",
          "refId": "A",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 3,
      "title": "API processing duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(kiali_api_processing_duration_seconds_bucket{k8s_cluster_name=\"$k8s_cluster_name\",namespace=\"$namespace\",job=\"$job\"}[$__rate_interval])) by(le,route))",
          "refId": "A",
          "legendFormat": "p50 {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kiali_api_processing_duration_seconds_bucket{k8s_cluster_name=\"$k8s_cluster_name\",namespace=\"$namespace\",job=\"$job\"}[$__rate_interval])) by(le,route))",
          "refId": "B",
          "legendFormat": "p95 {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(kiali_api_processing_duration_seconds_bucket{k8s_cluster_name=\"$k8s_cluster_name\",namespace=\"$namespace\",job=\"$job\"}[$__rate_interval])) by(le,route))",
          "refId": "C",
          "legendFormat": "p99 {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },

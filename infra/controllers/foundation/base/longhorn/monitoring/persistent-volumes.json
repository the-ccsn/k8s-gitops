      "pluginVersion": "v13.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(topk(1, kubelet_volume_stats_capacity_bytes{k8s_cluster_name=\"$k8s_cluster_name\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"})) without(instance,node) - sum(topk(1, kubelet_volume_stats_available_bytes{k8s_cluster_name=\"$k8s_cluster_name\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"})) without(instance,node)",
          "legendFormat": "Used Space",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(topk(1, kubelet_volume_stats_available_bytes{k8s_cluster_name=\"$k8s_cluster_name\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"})) without(instance,node)",
          "legendFormat": "Free Space",
          "refId": "B"
        }
      ],
      "title": "Volume Space Usage",
      "type": "timeseries"
    },

                "device",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "node": 0,
              "device": 1,
              "Value": 2
            },
            "renameByName": {
              "node": "Host",
              "device": "Disk",
              "Value": "Power-on time"
            }
          }
        }
      ]

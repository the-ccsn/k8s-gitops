        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(go_memstats_mallocs_total{pod=~\"istiod-.*\",k8s_cluster_name=\"$k8s_cluster_name\"}[$__rate_interval])) by(pod)",

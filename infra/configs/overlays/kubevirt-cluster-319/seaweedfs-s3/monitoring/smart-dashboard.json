{
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Current nonzero command exit masks per physical disk. Value 4 is a command/checksum warning; some SSDs reject the optional error-log request. Confirm the original smartctl output. Failed health and sector alerts are independent. Combined masks stay numeric. Empty results can also mean missing metrics: check collection and health panels.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Exit flags"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "index": 0,
                        "text": "0: Command OK"
                      },
                      "1": {
                        "index": 1,
                        "text": "1: Command syntax error"
                      },
                      "2": {
                        "index": 2,
                        "text": "2: Device unavailable / standby"
                      },
                      "4": {
                        "index": 3,
                        "text": "4: Command / checksum issue"
                      },
                      "8": {
                        "index": 4,
                        "text": "8: SMART health failed"
                      },
                      "16": {
                        "index": 5,
                        "text": "16: Prefailure threshold"
                      },
                      "32": {
                        "index": 6,
                        "text": "32: Past threshold violation"
                      },
                      "64": {
                        "index": 7,
                        "text": "64: Device error-log entries"
                      },
                      "128": {
                        "index": 8,
                        "text": "128: Self-test error-log entries"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 31,
      "type": "table",
      "title": "SMART query issues by disk",
      "options": {
        "cellHeight": "sm",
        "enablePagination": true,
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (node, instance, device) (smartctl_device_smartctl_exit_status{k8s_cluster_name=~\"$k8s_cluster_name\",job=\"smartctl\",instance=~\"$instance\"} != 0)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "Command flags"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true
            },
            "indexByName": {
              "node": 0,
              "device": 1,
              "Value": 2
            },
            "renameByName": {
              "node": "Host",
              "device": "Disk",
              "Value": "Exit flags"
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },

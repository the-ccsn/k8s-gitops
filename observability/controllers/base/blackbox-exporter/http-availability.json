{
  "annotations": {
    "list": []
  },
  "description": "Adapted from adinhodovic/blackbox-exporter-mixin (MIT), commit 7d2b9263d7adae3ec937c8ae0cb6003492616710. Per-probe views retain job, instance, probe path and IP family. Uptime uses the selected time range. Overview, failure list and timelines stay visible; protocol details are collapsed. Optional path/family All includes probes with those labels absent.",
  "editable": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Probe overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Current recorded status, separated by job, target, path and address family. Click a tile to select its target. Missing samples are not proof of health.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": true,
              "title": "Go To Probe",
              "type": "link",
              "url": "/d/http-availability?var-k8s_cluster_name=${__field.labels.k8s_cluster_name:percentencode}&var-job=${__field.labels.job:percentencode}&var-instance=${__field.labels.instance:percentencode}&var-probe_path=${__field.labels.probe_path:percentencode}&var-ip_family=${__field.labels.ip_family:percentencode}&from=${__from}&to=${__to}"
            }
          ],
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Failed"
                },
                "1": {
                  "color": "green",
                  "text": "Succeeded"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "maxDataPoints": 100,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "percentChangeColorMode": "standard",
        "showPercentChange": false,
        "text": {
          "titleSize": 18,
          "valueSize": 18
        },
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        }
      },
      "pluginVersion": "v11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(probe_success{k8s_cluster_name=\"$k8s_cluster_name\",job=~\"$job\",probe_path=~\"$probe_path\",ip_family=~\"$ip_family\",instance=~\"$instance\"}) by(instance,k8s_cluster_name,job,probe_path,ip_family)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Last recorded probe results",
      "type": "stat"
    },
    {
      "datasource": {

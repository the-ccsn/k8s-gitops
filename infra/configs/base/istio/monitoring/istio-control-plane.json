        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(go_memstats_heap_alloc_bytes{pod=~\"istiod-.*\",k8s_cluster_name=\"$k8s_cluster_name\"}) by(pod)",
          "legendFormat": "Heap (Allocated) ({{pod}})",
          "refId": "D"

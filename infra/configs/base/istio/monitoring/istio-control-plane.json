          "expr": "sum(go_memstats_stack_inuse_bytes{pod=~\"istiod-.*\",k8s_cluster_name=\"$k8s_cluster_name\"}) by(pod)",
          "legendFormat": "Stack ({{pod}})",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(go_memstats_heap_inuse_bytes{pod=~\"istiod-.*\",k8s_cluster_name=\"$k8s_cluster_name\"}) by(pod)",
          "legendFormat": "Heap (In Use) ({{pod}})",
          "refId": "C"

          },
          "expr": "max(((topk(1, kubelet_volume_stats_capacity_bytes{k8s_cluster_name=\"$k8s_cluster_name\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) - topk(1, kubelet_volume_stats_available_bytes{k8s_cluster_name=\"$k8s_cluster_name\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"})) / topk(1, kubelet_volume_stats_capacity_bytes{k8s_cluster_name=\"$k8s_cluster_name\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"})) * 100) without(instance,node)",
          "instant": true,

            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "count by (node, instance) (smartctl_device_smartctl_exit_status{k8s_cluster_name=~\"$k8s_cluster_name\",job=\"smartctl\",instance=~\"$instance\"} != 0) or 0 * count by (node, instance) (smartctl_device_smartctl_exit_status{k8s_cluster_name=~\"$k8s_cluster_name\",job=\"smartctl\",instance=~\"$instance\"})",
          "instant": true,
          "legendFormat": "{{node}}",

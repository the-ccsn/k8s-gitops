          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (node, instance, device)(smartctl_device_power_on_seconds{k8s_cluster_name=~\"$k8s_cluster_name\",job=\"smartctl\", instance=~\"$instance\"})",
          "instant": true,
          "legendFormat": "{{node}} / {{device}}",
          "range": false,
          "refId": "On-time",
          "format": "table"
        }
      ],
      "title": "Disk power-on time",
      "type": "table",

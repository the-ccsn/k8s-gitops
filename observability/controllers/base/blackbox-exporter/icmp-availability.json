        "defaults": {
          "links": [
            {
              "targetBlank": true,
              "title": "Go To Probe",
              "type": "link",
              "url": "/d/icmp-availability?var-k8s_cluster_name=${__field.labels.k8s_cluster_name:percentencode}&var-job=${__field.labels.job:percentencode}&var-instance=${__field.labels.instance:percentencode}"
            }
          ],
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              }

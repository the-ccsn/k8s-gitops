    {
      "id": 2000,
      "title": "Failed probes and scrape failures",
      "description": "Only recorded failures appear here. An empty table does not establish the health of a target that has no samples. A protocol job must have been discovered before it can appear in the selector.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace((max(probe_success{k8s_cluster_name=\"$k8s_cluster_name\",job=~\"$job\",instance=~\"$instance\",probe_path=~\"$probe_path\",ip_family=~\"$ip_family\"}) by(k8s_cluster_name,job,instance,probe_path,ip_family) == 0) unless on(k8s_cluster_name,job,instance,probe_path,ip_family) (max(up{k8s_cluster_name=\"$k8s_cluster_name\",job=~\"$job\",instance=~\"$instance\",probe_path=~\"$probe_path\",ip_family=~\"$ip_family\"}) by(k8s_cluster_name,job,instance,probe_path,ip_family) == 0), \"failure\", \"Probe failed\", \"\", \"\") or label_replace(max(up{k8s_cluster_name=\"$k8s_cluster_name\",job=~\"$job\",instance=~\"$instance\",probe_path=~\"$probe_path\",ip_family=~\"$ip_family\"}) by(k8s_cluster_name,job,instance,probe_path,ip_family) == 0, \"failure\", \"Scrape failed\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "k8s_cluster_name": true
            },
            "renameByName": {
              "job": "Probe job",
              "instance": "Target",
              "probe_path": "Path",
              "ip_family": "Address family",
              "failure": "Failure",
              "Value": "Status"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Asia/Shanghai",
  "dependencyDashboard": true,
  "flux": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.ya?ml$/"],
    "ignorePaths": [
      "**/*-v*.*.*.yaml",
      "infra/configs/base/cloudnative-pg/official-image-catalogs/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^apps/base/headlamp/helm-release\\.yaml$/"],
      "matchStrings": [
        "reference:\\s*(?<depName>ghcr\\.io/[^\\s:]+):(?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:-[^\\s]+)?)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "matchPackageNames": ["adyanth/cloudflare-operator"],
      "allowedVersions": "!/^(10|10\\.0|10\\.0\\.2)$/"
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Track versioned Headlamp plugin image volumes",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["apps/base/headlamp/helm-release.yaml"],
      "matchDatasources": ["docker"],
      "pinDigests": false,
      "ignoreUnstable": true
    }
  ]
}
